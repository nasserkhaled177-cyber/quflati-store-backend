const express = require('express');
const router = express.Router();
const { PrismaClient } = require('@prisma/client');
const prisma = new PrismaClient();

const RESERVE_MINUTES = 30;

// دالة ترجع الكمية المحجوزة لمنتج
async function getReservedQty(productId){
  const res = await prisma.cartReservation.findMany({
    where: { productId, status: 'reserved', expiresAt: { gt: new Date() } }
  });
  return res.reduce((s,r)=> s + r.quantity, 0);
}

// GET المخزون الفعلي للعرض في المتجر
router.get('/stock/:productId', async (req,res)=>{
  const prod = await prisma.product.findUnique({where:{id:req.params.productId}});
  if(!prod) return res.json({available:0});
  const reserved = await getReservedQty(req.params.productId);
  res.json({ total: prod.stock, reserved, available: Math.max(0, prod.stock - reserved) });
});

// POST اضافة للسلة - ينقص من الظاهر
router.post('/add', async (req,res)=>{
  const { productId, quantity, sessionId } = req.body;
  const prod = await prisma.product.findUnique({where:{id:productId}});
  if(!prod) return res.status(404).json({error:'not found'});

  const reserved = await getReservedQty(productId);
  const available = prod.stock - reserved;
  if(quantity > available) return res.status(400).json({error:`الكمية المتاحة فقط ${available}`});

  // احذف حجز قديم لنفس الجلسة ونفس المنتج
  await prisma.cartReservation.deleteMany({ where:{ productId, sessionId, status:'reserved' }});

  const reservation = await prisma.cartReservation.create({
    data:{
      productId,
      productName: prod.name,
      quantity,
      price: prod.price,
      supplierId: prod.supplierId,
      supplierName: prod.supplierName,
      sessionId,
      image: prod.imageUrl,
      status: 'reserved',
      expiresAt: new Date(Date.now() + RESERVE_MINUTES*60*1000)
    }
  });
  res.json(reservation);
});

// GET سلة العميل
router.get('/:sessionId', async (req,res)=>{
  // نظف المنتهي اول
  await prisma.cartReservation.updateMany({
    where:{ expiresAt:{ lt: new Date() }, status:'reserved' },
    data:{ status:'expired' }
  });
  const cart = await prisma.cartReservation.findMany({
    where:{ sessionId:req.params.sessionId, status:'reserved', expiresAt:{ gt:new Date() } },
    orderBy:{createdAt:'desc'}
  });
  res.json(cart);
});

// DELETE حذف من السلة - يرجع للمتجر فورا
router.delete('/:id', async (req,res)=>{
  await prisma.cartReservation.delete({where:{id:req.params.id}});
  res.json({ok:true});
});

// POST تأكيد الطلب - يحول الحجز لفواتير
router.post('/checkout', async (req,res)=>{
  const { sessionId, customer } = req.body; // customer: {name, phone, address, lat, lng}
  const cart = await prisma.cartReservation.findMany({
    where:{ sessionId, status:'reserved', expiresAt:{ gt:new Date() } }
  });
  if(!cart.length) return res.status(400).json({error:'السلة فارغة او انتهت صلاحيتها'});

  const gross = cart.reduce((s,i)=> s + (i.price*i.quantity),0);
  const appFee10 = gross*0.10;
  const tax15 = gross*0.15;
  const net = gross - appFee10 - tax15;
  const orderNumber = 'QUF-'+Date.now();

  const supplierIds = [...new Set(cart.map(c=>c.supplierId))];

  const masterOrder = await prisma.masterOrder.create({
    data:{
      orderNumber,
      customerName: customer.name,
      customerPhone: customer.phone,
      customerAddress: customer.address,
      customerLat: customer.lat||0,
      customerLng: customer.lng||0,
      gross, appFee10, tax15, net, totalAmount: gross,
      status: 'pending',
      items:{
        create: cart.map(c=>({
          productId: c.productId,
          name: c.productName,
          image: c.image,
          quantity: c.quantity,
          receivedQuantity:0,
          price:c.price,
          supplierId:c.supplierId,
          supplierName:c.supplierName
        }))
      },
      subOrders:{
        create: supplierIds.map(sId=>{
          const f = cart.find(x=>x.supplierId==sId);
          return { supplierId:sId, supplierName:f.supplierName, status:'pending' }
        })
      }
    },
    include:{items:true, subOrders:true}
  });

  // اخصم من المخزون الحقيقي واعتبر الحجز مؤكد
  for(let c of cart){
    await prisma.product.update({ where:{id:c.productId}, data:{ stock: { decrement: c.quantity } } });
    await prisma.cartReservation.update({ where:{id:c.id}, data:{ status:'confirmed' } });
  }

  res.json({ invoice: masterOrder, message:'تم انشاء الفاتورة' });
});

// Cron كل دقيقة يرجع المنتجات المنتهية
setInterval(async ()=>{
  try{
    const expired = await prisma.cartReservation.findMany({
      where:{ status:'reserved', expiresAt:{ lt:new Date() } }
    });
    if(expired.length){
      await prisma.cartReservation.updateMany({
        where:{ status:'reserved', expiresAt:{ lt:new Date() } },
        data:{ status:'expired' }
      });
      console.log(`[CART] expired ${expired.length} reservations returned to store`);
    }
  }catch(e){ console.log(e.message)}
}, 60*1000);

module.exports = router;
